    "docker:build": "docker buildx build ${DOCKER_PLATFORM:+--platform=$DOCKER_PLATFORM} --build-arg GIT_SHA=\"${GIT_SHA:-unknown}\" -t \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}pauseai-es/pauseai-everything:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\" .",
